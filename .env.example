# Copiez ces variables dans l’environnement de l’application Python cPanel.
# Ne mettez jamais de vraies valeurs dans GitHub.
APP_SECRET=remplacer-par-une-valeur-aleatoire-de-32-caracteres-minimum
ALLOWED_ORIGINS=https://votre-domaine.com

# SMTP o2switch / boîte email du domaine
SMTP_HOST=nom-du-serveur.o2switch.net
SMTP_PORT=465
SMTP_USE_TLS=false
SMTP_USERNAME=euloge@votre-domaine.com
SMTP_PASSWORD=mot-de-passe-a-definir-dans-cpanel
MAIL_FROM=euloge@votre-domaine.com
MAIL_TO=euloge@oloustream.com

# Accès export CSV des prospects
ADMIN_USER=admin
ADMIN_PASSWORD=mot-de-passe-long-et-unique
# Optionnel : chemin hors dossier public si disponible
# LEADS_DB_PATH=/home/compte/data/coach-olou/leads.sqlite3
